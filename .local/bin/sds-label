#!/usr/bin/env python3
"""Estrae gli elementi di etichetta (sez. 1.1 / 1.2 / 1.3 / 2.2) da una SDS .docx
EpyX e li stampa in PDF via typst.

    sds-label SDS.docx [ALTRE.docx ...]      -> <stesso nome, SDS -> LABEL>.pdf
    sds-label -o etichetta.pdf SDS.docx
    sds-label --keep-typ SDS.docx            # tiene il .typ per ritocchi a mano
    sds-label --self-check
"""
import argparse, glob, json, os, re, shutil, subprocess, sys, tempfile, zipfile
import xml.etree.ElementTree as ET

W = "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}"
A = "{http://schemas.openxmlformats.org/drawingml/2006/main}"
R = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
V = "{urn:schemas-microsoft-com:vml}"
CONTACT = re.compile(r"tel|fax|e-?mail|phone|mail", re.I)
FONT = '("Liberation Sans", "DejaVu Sans")'
CODE = re.compile(r"^(?:EUH|H|P)\d[\d+P]*$")   # codici omettibili in etichetta
NOTA = "Ciò che è scritto in rosso si può omettere in etichetta."
PROFILI = os.path.expanduser("~/.claude/skills/sds-rebrand/profiles")
PROMEMORIA = [
    "Marcatura ambientale imballaggi (D.Lgs. 116/2020, all. Reg. UE 2025/40): "
    "codice identificativo del materiale e istruzioni di conferimento su OGNI "
    "componente (bottiglia, tappo, bastoncini, astuccio).",
    "Dir. (UE) 2024/825: vietati i claim ambientali generici (\u201ceco\u201d, "
    "\u201cgreen\u201d, \u201cnaturale\u201d, \u201cbiodegradabile\u201d, "
    "\u201cclimaticamente neutro\u201d) e i loghi / marchi di sostenibilità non "
    "basati su uno schema di certificazione riconosciuto o su norme pubbliche.",
    "Nessun claim ambientale sull'intero prodotto se riguarda solo un aspetto "
    "(es. il solo imballo); nessun logo pro-ambiente auto-attribuito.",
]


def contatto(k, v):
    """riga di recapito: da tenere fuori dall'indirizzo in etichetta.
    La chiave cambia con la lingua (FR e-mail = "Courrier"), quindi guarda
    anche il valore."""
    return bool(CONTACT.search(k)) or "@" in str(v)


def text(el):
    """testo di un elemento, un capoverso per riga."""
    lines = ["".join(t.text or "" for t in p.iter(W + "t")).strip()
             for p in el.iter(W + "p")]
    return "\n".join(l for l in lines if l)


def cells(tr):
    return [text(tc) for tc in tr.findall(W + "tc")]


def images(el):
    """rId delle immagini incorporate: DrawingML (a:blip) e VML (v:imagedata)."""
    ids = [b.get(R + "embed") for b in el.iter(A + "blip")]
    ids += [v.get(R + "id") for v in el.iter(V + "imagedata")]
    return [i for i in ids if i]


def parse(path):
    """-> dict con prodotto, ufi, uso, fornitore, blocchi 2.2, id immagini."""
    with zipfile.ZipFile(path) as z:
        body = ET.fromstring(z.read("word/document.xml"))[0]
        rels = {r.get("Id"): r.get("Target")
                for r in ET.fromstring(z.read("word/_rels/document.xml.rels"))}

    sec, tables = None, {}       # sec -> lista di tabelle (liste di righe)
    blocks, pics = [], []        # blocchi 2.2, rId dei pittogrammi
    for el in body:
        tag = el.tag.split("}")[1]
        if tag == "p":
            m = re.match(r"(\d+\.\d+)\s+\S", text(el))
            if m:
                sec = m.group(1)
            continue
        if tag != "tbl":
            continue
        rows = [cells(tr) for tr in el.findall(W + "tr")]
        tables.setdefault(sec, []).append(rows)
        if sec == "2.2":
            rid = images(el)
            title = rows[0][0] if rows and rows[0] else ""
            body_rows = [r for r in rows[1:] if any(r)]
            if rid:
                pics += rid
                blocks.append((title, "pics", []))
            else:
                blocks.append((title, "rows", body_rows))

    def kv(sec):
        return [(r[0], r[1]) for t in tables.get(sec, []) for r in t if len(r) > 1]

    ident = kv("1.1")
    ufi = next((v for k, v in ident if k.upper().startswith("UFI")), "")
    # i nomi commerciali stanno su piu' righe della stessa cella o su piu' righe
    # della tabella (vedi SENSUAL): prendili tutti.
    nomi = [l.strip() for k, v in ident if not k.upper().startswith("UFI")
            for l in v.splitlines() if l.strip()]
    uso = next((r[0] for t in tables.get("1.2", []) for r in t[1:] if r and r[0]), "")
    uso = re.split(r"[–—]", uso)[0].strip(" .")   # via "– Usi di consumo"

    forn = [(k, v) for k, v in kv("1.3") if not contatto(k, v)]
    return {
        "nomi": nomi,
        "prodotto": nomi[:1],
        "ufi": ufi,
        "uso": uso,
        "fornitore": forn[0][1] if forn else "",
        "indirizzo": " - ".join(v for _, v in forn[1:] if v),
        "blocchi": blocks,
        "pics": list(dict.fromkeys(
            rels[i] for i in pics
            if i in rels and not rels[i].startswith("ooxWord"))),
    }


def menu(titolo, voci, multi=False):
    """mini selettore: invio = prima voce. -> lista di indici scelti."""
    if len(voci) < 2 or not sys.stdin.isatty():
        return [0] if voci else []
    print("\n" + titolo, file=sys.stderr)
    for i, v in enumerate(voci, 1):
        print(f"  {i}) {v}" + ("   [invio]" if i == 1 else ""), file=sys.stderr)
    n = [int(x) for x in re.findall(r"\d+", input("> "))]
    idx = [x - 1 for x in n if 0 < x <= len(voci)]
    return (idx if multi else idx[:1]) or [0]


def anagrafiche():
    """-> [(nome profilo, (ragione sociale, indirizzo)), ...] da sds-rebrand."""
    out = []
    for f in sorted(glob.glob(os.path.join(PROFILI, "*.json"))):
        with open(f) as fh:
            campi = [(k, v) for k, v in json.load(fh)["fields"].items()
                     if v and not contatto(k, v)]
        if campi:
            out.append((os.path.basename(f)[:-5],
                        (campi[0][1], " - ".join(v for _, v in campi[1:]))))
    return out


def scegli(d):
    """chiede nomi commerciali e anagrafica; invio = default della SDS."""
    d["prodotto"] = [d["nomi"][i] for i in
                     menu("Nomi commerciali (più scelte: 1,2):", d["nomi"], True)]
    opz = [("SDS", (d["fornitore"], d["indirizzo"]))] + anagrafiche()
    i = menu("Anagrafica:", [f"{n} - {a[0]}" for n, a in opz])[0]
    d["fornitore"], d["indirizzo"] = opz[i][1]
    return d


def s(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def c(v):
    """valore -> contenuto typst, con a capo veri fra i capoversi."""
    return " \\ ".join("#" + s(l) for l in str(v).splitlines() if l.strip())


def typ(d, picfiles):
    out = [
        '#set page(paper: "a4", margin: 1.6cm)',
        f"#set text(font: {FONT}, size: 10pt, lang: \"it\")",
        "#set par(justify: false)",
        "#align(center)[",
    ]
    for i, line in enumerate(d["prodotto"]):
        size = "16pt" if i == 0 else "11pt"
        out.append(f"  #text(size: {size}, weight: \"bold\")[{c(line)}]\\")
    if d["ufi"]:
        out.append(f"  #text(size: 11pt)[UFI: #text(weight: \"bold\")[{c(d['ufi'])}]]")
    out += ["]", "#v(8pt)", "#align(center)[",
            f"  #text(weight: \"bold\")[{c(d['fornitore'])}]\\",
            f"  {c(d['indirizzo'])}", "]"]
    if d["uso"]:
        out += ["#v(8pt)", "#align(center)[#text(size: 12pt, weight: \"bold\")"
                f"[#upper({s(d['uso'].replace(chr(10), ' '))})]]"]
    out.append("#v(10pt)")

    for title, kind, rows in d["blocchi"]:
        if kind == "pics":
            imgs = ", ".join(f'image({s(os.path.basename(p))}, width: 16mm)'
                             for p in picfiles)
            out += [f"#grid(columns: (36mm, 1fr), gutter: 6pt,",
                    f"  text(weight: \"bold\")[{c(title)}],",
                    f"  stack(dir: ltr, spacing: 4mm, {imgs}))", "#v(6pt)"]
        elif len(rows) == 1 and len(rows[0]) == 1:      # Avvertenza, Contiene, ...
            # "Avvertenza" e' un'intestazione della SDS: in etichetta va solo
            # la parola di segnalazione, quindi il titolo e' omettibile.
            red = "fill: red, " if title.strip().lower() == "avvertenza" else ""
            out += [f"#grid(columns: (36mm, 1fr), gutter: 6pt,",
                    f"  text({red}weight: \"bold\")[{c(title)}],",
                    f"  text(weight: \"bold\")[{c(rows[0][0])}])", "#v(6pt)"]
        else:
            codes = [len(r) > 1 and bool(CODE.match(r[0])) for r in rows]
            head = 'fill: red, ' if codes and all(codes) else ""
            out.append(f"#text({head}weight: \"bold\")[{c(title)}]")
            body = ",\n".join(
                f"  text({'fill: red, ' if cod else ''}weight: \"bold\")"
                f"[{c(r[0])}], [{c(r[1])}]" if len(r) > 1
                else f"  [], [{c(r[0])}]" for r, cod in zip(rows, codes))
            out += ["#v(2pt)",
                    "#grid(columns: (36mm, 1fr), gutter: 6pt, row-gutter: 4pt,",
                    body + ")", "#v(8pt)"]
    if "fill: red" in "".join(out):
        out += ["#v(4pt)", f"#text(size: 9pt, fill: red)[{c(NOTA)}]"]
    out += ["#v(12pt)",
            "#block(width: 100%, inset: 7pt, radius: 2pt, stroke: 0.6pt + gray)[",
            '  #text(size: 9pt, weight: "bold")[PROMEMORIA]',
            "  #v(3pt)",
            "  #text(size: 8.5pt)[#list(spacing: 4pt, "
            + ", ".join("[" + c(x) + "]" for x in PROMEMORIA) + ")]",
            "]"]
    return "\n".join(out) + "\n"


def build(src, dst, keep):
    d = parse(src)
    if not d["nomi"] or not d["blocchi"]:
        return None          # non e' una SDS EpyX: niente sez. 1.1 o 2.2
    print(f"\n== {os.path.basename(src)}", file=sys.stderr)
    d = scegli(d)
    dst = dst or default_name(src, d)
    tmp = tempfile.mkdtemp(prefix="sds-label-")
    with zipfile.ZipFile(src) as z:
        for p in d["pics"]:
            with open(os.path.join(tmp, os.path.basename(p)), "wb") as f:
                f.write(z.read("word/" + p))
    tp = os.path.join(tmp, "label.typ")
    with open(tp, "w") as f:
        f.write(typ(d, d["pics"]))
    subprocess.run(["typst", "compile", tp, dst], check=True)
    if keep:
        shutil.copy(tp, os.path.splitext(dst)[0] + ".typ")
        for p in d["pics"]:
            shutil.copy(os.path.join(tmp, os.path.basename(p)),
                        os.path.dirname(dst) or ".")
    shutil.rmtree(tmp)
    return dst


def default_name(src, d):
    """stesso schema del .docx, con LABEL al posto di SDS."""
    b = os.path.splitext(os.path.basename(src))[0]
    name = b.replace("SDS", "LABEL", 1) if "SDS" in b else b + "__LABEL"
    return os.path.join(os.path.dirname(os.path.abspath(src)), name + ".pdf")


def self_check():
    x = f'''<w:document xmlns:w="{W[1:-1]}"><w:body>
      <w:p><w:r><w:t>1.1 Identificatore del prodotto</w:t></w:r></w:p>
      <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Denominazione</w:t></w:r></w:p></w:tc>
        <w:tc><w:p><w:r><w:t>PIPPO</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p/></w:tc>
        <w:tc><w:p><w:r><w:t>PIPPO EXPORT</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>UFI:</w:t></w:r></w:p></w:tc>
        <w:tc><w:p><w:r><w:t>ABCD-1234</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
      <w:p><w:r><w:t>1.2 Usi identificati</w:t></w:r></w:p>
      <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Usi identificati</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>Profumatore ambientale. – Usi di consumo</w:t>
        </w:r></w:p></w:tc></w:tr></w:tbl>
      <w:p><w:r><w:t>1.3 Informazioni sul fornitore</w:t></w:r></w:p>
      <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Ragione Sociale</w:t></w:r></w:p></w:tc>
        <w:tc><w:p><w:r><w:t>ACME Srl</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>Indirizzo</w:t></w:r></w:p></w:tc>
        <w:tc><w:p><w:r><w:t>Via Roma 1</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>fax</w:t></w:r></w:p></w:tc>
        <w:tc><w:p><w:r><w:t>02-123</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
      <w:p><w:r><w:t>2.2 Elementi dell'etichetta</w:t></w:r></w:p>
      <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Avvertenza</w:t></w:r></w:p></w:tc></w:tr>
        <w:tr><w:tc><w:p><w:r><w:t>Pericolo</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
      <w:tbl><w:tr><w:tc><w:p><w:r><w:t>Indicazioni di pericolo</w:t></w:r></w:p></w:tc>
          <w:tc><w:p/></w:tc></w:tr>
        <w:tr><w:tc><w:p><w:r><w:t>H319</w:t></w:r></w:p></w:tc>
          <w:tc><w:p><w:r><w:t>Irrita gli "occhi"</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
      <w:p><w:r><w:t>2.3 Altri pericoli</w:t></w:r></w:p></w:body></w:document>'''
    tmp = tempfile.mkdtemp()
    p = os.path.join(tmp, "f.docx")
    with zipfile.ZipFile(p, "w") as z:
        z.writestr("word/document.xml", x)
        z.writestr("word/_rels/document.xml.rels",
                   '<Relationships xmlns="http://schemas.openxmlformats.org/'
                   'package/2006/relationships"/>')
    d = parse(p)
    assert d["nomi"] == ["PIPPO", "PIPPO EXPORT"], d["nomi"]
    assert d["prodotto"] == ["PIPPO"], d["prodotto"]      # invio = il primo
    assert menu("x", d["nomi"], True) == [0]              # non-tty -> default
    assert d["ufi"] == "ABCD-1234", d["ufi"]
    assert d["fornitore"] == "ACME Srl" and d["indirizzo"] == "Via Roma 1", d
    assert [b[0] for b in d["blocchi"]] == ["Avvertenza", "Indicazioni di pericolo"], d
    assert d["blocchi"][1][2] == [["H319", 'Irrita gli "occhi"']], d["blocchi"]
    src = typ(d, [])
    assert '\\"occhi\\"' in src and "2.3" not in src
    assert c("a\nb") == '#"a" \\ #"b"'
    assert c("") == "" and c("  ") == ""   # cella vuota -> contenuto vuoto, non «»
    assert 'fill: red, weight: "bold")[#"H319"]' in src, src
    assert "omettere in etichetta" in src and "RETRO" not in src
    assert 'text(fill: red, weight: "bold")[#"Avvertenza"]' in src, src
    assert "2024/825" in src and "116/2020" in src
    an = anagrafiche()
    assert an and all(a[1][0] and a[1][1] for a in an), an
    assert not any("@" in a[1][1] for a in an), an   # niente e-mail in indirizzo
    assert d["uso"] == "Profumatore ambientale", d["uso"]
    assert default_name("/x/A--B__SDS_IT_REV2.docx", d).endswith("A--B__LABEL_IT_REV2.pdf")
    assert default_name("/x/pippo.docx", d).endswith("pippo__LABEL.pdf")
    with zipfile.ZipFile(p, "w") as z:      # docx qualsiasi, non una SDS
        z.writestr("word/document.xml",
                   f'<w:document xmlns:w="{W[1:-1]}"><w:body><w:p><w:r>'
                   '<w:t>resoconto</w:t></w:r></w:p></w:body></w:document>')
        z.writestr("word/_rels/document.xml.rels",
                   '<Relationships xmlns="http://schemas.openxmlformats.org/'
                   'package/2006/relationships"/>')
    assert build(p, None, False) is None, "un docx non-SDS va saltato"
    shutil.rmtree(tmp)
    print("self-check ok")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*")
    ap.add_argument("-o", "--output", help="pdf di destinazione (un solo file in input)")
    ap.add_argument("--keep-typ", action="store_true", help="tiene il .typ e le immagini")
    ap.add_argument("--self-check", action="store_true")
    a = ap.parse_args()
    if a.self_check:
        return self_check()
    if not a.files:
        ap.error("serve almeno un .docx")
    if a.output and len(a.files) > 1:
        ap.error("-o vale per un solo file")
    for f in a.files:
        out = build(f, a.output, a.keep_typ)
        print(out) if out else print(f"salto {os.path.basename(f)}: "
                                     "niente elementi di etichetta", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# Super+W: un task al volo con la sintassi rapida di Tasks («Chiamare fornitore !domani 9:00 ~lavoro #telefono»).
# Una riga in rofi, poi tasks-cli add (passa dall'app Tasks se è aperta, se no dal server col login del vault).
t=$(rofi -dmenu -p "Nuovo task" -l 0 -theme-str 'window {width: 40%;}' </dev/null) || exit 0
[ -n "${t// }" ] || exit 0
if out=$(tasks-cli add "$t" 2>&1); then
  notify-send -a Tasks "Task creato" "$t"
else
  notify-send -u critical -a Tasks "Task non creato" "$out"
fi

#!/usr/bin/env bash
# Segreti del desktop: la fonte è il vault Bitwarden (cartella "desktop", nota di ogni elemento).
# Li scrive in RAM ($XDG_RUNTIME_DIR/secrets) e i percorsi che i programmi leggono diventano
# collegamenti a quei file: su disco non resta niente in chiaro.
# Parte al login da autostart.lua di Hyprland (chiede la master password una volta, vale anche
# per SSH). Rilanciarlo se allora la richiesta è stata annullata o dopo aver cambiato il vault.
# Elenco nel vault: lo username di ogni elemento di "desktop" è "PERCORSO [copia]" (relativo a
# $HOME); senza username l'elemento non si sincronizza. Nuovo segreto: secret-put.
set -euo pipefail

dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/secrets"
umask 077
mkdir -p "$dir"
# --login (da autostart): via token e copia locale del vault, così lo sblocco rifà il login sul
# server con master password e codice 2FA a ogni accesso. Senza rete al login: niente vault.
[[ ${1:-} == --login ]] && rbw purge
# Token e copia del vault di rbw in RAM: a PC spento su disco non restano (il disco non è cifrato
# e la copia si apre con la sola master password, il 2FA protegge solo il login sul server)
cache="${XDG_CACHE_HOME:-$HOME/.cache}/rbw"
mkdir -p "${dir%/*}/rbw-cache"
if [[ ! -L $cache ]]; then
    rbw purge
    rm -rf "$cache"
    ln -s "${dir%/*}/rbw-cache" "$cache"
fi
rbw unlock
rbw sync || echo "secrets-sync: sync non riuscito, uso la copia locale del vault" >&2

# Percorsi sincronizzati (non segreti), per l'hook di Claude Code che ne blocca la lettura
state="${XDG_STATE_HOME:-$HOME/.local/state}/secrets-sync"
mkdir -p "$state"
paths=()

# modo "copia": file vero (600) su disco, per chi rifiuta i collegamenti (cpm)
while IFS=$'\t' read -r id name user folder; do
    [[ $folder == desktop && -n $user ]] || continue
    [[ $name != */* ]] || { echo "secrets-sync: nome con '/' saltato: $name" >&2; continue; }
    read -r path mode <<<"$user"
    link="$HOME/$path"
    paths+=("$link")
    rbw get --field notes "$id" > "$dir/$name.tmp"
    # un file vero con un contenuto diverso dal vault non si tocca, a meno che sia la copia
    # scritta l'ultima volta (valore cambiato nel vault): va prima confrontato a mano
    if [[ -f $link && ! -L $link ]] && ! cmp -s "$link" "$dir/$name.tmp" &&
        ! { [[ -f $dir/$name ]] && cmp -s "$link" "$dir/$name"; }; then
        echo "secrets-sync: $link è diverso dal vault, lasciato com'è" >&2
        rm -f "$dir/$name.tmp"
        continue
    fi
    mv "$dir/$name.tmp" "$dir/$name"
    mkdir -p "$(dirname "$link")"
    if [[ $mode == copia ]]; then
        rm -f "$link"
        cp "$dir/$name" "$link"
    else
        ln -sfn "$dir/$name" "$link"
    fi
done < <(rbw list --fields id,name,user,folder)

printf '%s\n' "${paths[@]}" > "$state/paths.tmp" && mv "$state/paths.tmp" "$state/paths"

#!/usr/bin/env bash
# Segreto nuovo (o valore nuovo) nel vault Bitwarden senza che passi da schermo, chat o argv.
#   secret-put NOME PERCORSO [copia] < valore     PERCORSO relativo a $HOME
#   secret-put --clip NOME PERCORSO [copia]       valore dagli appunti, poi tolto anche da cliphist
#   secret-put --forget-clip NOME PERCORSO [copia] < valore   come il primo, poi via gli appunti
#     (per un valore composto che usa wl-paste, es. una riga in più in un .env o .toml)
# Elemento in "desktop": valore nella nota, "PERCORSO [copia]" nello username; poi secrets-sync lo
# scrive in RAM e collega PERCORSO (copia = file vero, per chi rifiuta i collegamenti).
set -euo pipefail

clip= forget=
case ${1:-} in
    --clip) clip=1 forget=1; shift ;;
    --forget-clip) forget=1; shift ;;
esac
if (( $# < 2 || $# > 3 )) || [[ $1 == */* || $2 == /* || ${3:-copia} != copia ]]; then
    sed -n '3,6s/^# *//p' "$0" >&2
    exit 2
fi
name=$1 user="$2${3:+ $3}"

dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/secrets"
umask 077
mkdir -p "$dir"
tmp=$(mktemp "$dir/.put.XXXXXX") cur=$(mktemp "$dir/.clip.XXXXXX")
trap 'rm -f "$tmp" "$cur"' EXIT
if [[ $clip ]]; then
    wl-paste --no-newline > "$tmp"
else
    cat > "$tmp"
fi
[[ -s $tmp ]] || { echo "secret-put: valore vuoto" >&2; exit 1; }
if [[ $forget ]]; then
    # cliphist ha già salvato gli appunti su disco: via le voci recenti con lo stesso contenuto
    wl-paste --no-newline > "$cur" 2>/dev/null || true
    mapfile -t recent < <(cliphist list | head -n 50)
    for line in "${recent[@]}"; do
        cliphist decode <<<"$line" | cmp -s - "$cur" && cliphist delete <<<"$line"
    done
    wl-copy --clear
fi

rbw unlock
rbw sync
list() { rbw list --fields id,name,folder | awk -F'\t' -v n="$name" '$2 == n && $3 == "desktop" {print $1}'; }
old=$(list)
# prima riga = password (vuota), il resto = nota; rbw legge da stdin se non è un terminale
{ echo; cat "$tmp"; } | rbw add --folder desktop "$name" "$user"
new=$(comm -13 <(sort <<<"$old") <(list | sort))
[[ -n $new && $new != *$'\n'* ]] || { echo "secret-put: elemento nuovo non trovato nel vault" >&2; exit 1; }
# il vecchio elemento si toglie solo se il nuovo restituisce lo stesso valore
if [[ "$(rbw get --field notes "$new")" != "$(<"$tmp")" ]]; then
    rbw remove "$new"
    echo "secret-put: il vault non restituisce il valore scritto, lasciato il precedente" >&2
    exit 1
fi
for id in $old; do rbw remove "$id"; done

secrets-sync
echo "secret-put: $name → ~/$2${3:+ ($3)}"

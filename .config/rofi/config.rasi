/* rofi: per ora solo rofi-rbw (Super+P, Bitwarden). fuzzel 1.14 non ha più --override,
   che rofi-rbw usa per le scorciatoie Alt+…: con rofi funzionano tutte.
   Colori, font, cornice e angoli dal tema del desktop (~/.local/bin/theme), come i widget:
   cornice dell'accento attenuato perché prende la tastiera, corrispondenze nell'accento. */
@theme "/dev/null"   /* senza il tema predefinito, che colora le righe alterne di crema */

configuration {
    show-icons: false;   /* il font (e la dimensione, più grande sul G9) arriva dal tema */
}

@import "~/.local/state/theme/rofi.rasi"   /* font, bg raised fg dim accent selected frame, bordo e angoli */

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 50%;
    background-color: @bg;
    border-color: @frame;
    padding: 12px;
}
mainbox  { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar { spacing: 8px; children: [ prompt, entry ]; }
prompt   { text-color: @accent; }
entry    { placeholder: "cerca"; placeholder-color: @dim; }
textbox  { text-color: @dim; }
listview { lines: 12; scrollbar: false; spacing: 2px; }
element  { padding: 2px 6px; }
element selected.normal { background-color: @selected; text-color: @accent; }
element-text { text-color: inherit; }   /* highlight (colore delle corrispondenze) nel file del tema: non accetta @variabili */
